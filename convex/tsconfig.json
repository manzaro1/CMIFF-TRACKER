{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "target": "ESNext",
    "jsx": "react-jsx"
  },
  "include": ["./**/*"],
  "exclude": ["../node_modules", "./_generated"]
}
